# .DS_Store sengaja tetap dilacak — lihat commit yang mengembalikannya.
# Isinya metadata Finder dan berubah sendiri tiap folder dibuka, jadi ia akan
# sering muncul di git status.

# Kredensial Google — langkah 2 rencana di README menghasilkan keduanya.
# Jangan pernah masuk repo.
credentials.json
token.json

# Python (menyusul bersama backend)
__pycache__/
*.py[cod]
.venv/
venv/

# Foto sungguhan. Kerangka contoh di simulasi/ tetap dilacak lewat pengecualian
# di bawah; semua JPG lain — hasil jepretan nyata — tidak.
*.JPG
*.jpg
*.jpeg
*.CR2
*.NEF
*.ARW
!prototipe/favicon mcf.jpeg
!simulasi/local_archive/Budi_Ani_20260811_115043/*.JPG
