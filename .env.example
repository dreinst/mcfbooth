# Salin berkas ini menjadi `.env` di akar repo, lalu isi yang perlu.
# Semua nilai opsional — tanpa .env aplikasi memakai bawaan di bawah.

# --- Kamera & tethering (hanya label yang tampil di Pengaturan) ---
CAMERA_MODEL=Sony ZV-E10
TETHERING_APP=Imaging Edge Desktop

# --- Folder (bawaan: di akar repo; path relatif dihitung dari akar repo).
# Di Windows tulis TANPA tanda kutip, atau pakai garis miring biasa: D:/Foto Acara/tether
# (python-dotenv menafsirkan \t, \a, dsb. di dalam tanda kutip ganda).
# TETHER_DROPBOX=./tether_dropbox
# LOCAL_ARCHIVE=./local_archive
# THUMBS=./thumbs
# QR_CODES=./qr_codes
# MCF_DB=./sessions.db

# --- Google Drive ---
# ID folder induk di Drive. HANYA berfungsi kalau folder itu dibuat oleh aplikasi
# ini (scope drive.file tidak melihat folder buatan tangan). Kosongkan supaya
# aplikasi membuat folder induknya sendiri ("MCF Photobooth") di akar Drive.
DRIVE_PARENT_FOLDER_ID=
DRIVE_ROOT_NAME=MCF Photobooth
DRIVE_FOLDER_QR=1. QR
DRIVE_FOLDER_RESULT=2. Result
# GOOGLE_CREDENTIALS=./credentials.json
# GOOGLE_TOKEN=./token.json

# --- Perilaku watcher ---
# Berkas dianggap selesai ditulis kalau ukurannya tidak berubah selama N detik.
STABILITAS_DETIK=1.5
# Batas menunggu berkas stabil sebelum dilewati (dicoba lagi oleh penjaga).
# STABIL_TIMEOUT=45
# Foto yang mendarat setelah Selesai masih dihitung milik sesi itu selama N detik;
# batal begitu operator mengetik nama tamu berikutnya.
TENGGANG_SETELAH_SELESAI=45
# Penjaga latar: tiap N detik mengulang upload yang gagal dan menyapu folder tether.
# PENJAGA_DETIK=30
# Jumlah upload ke Drive yang berjalan bersamaan.
# UPLOAD_PARALEL=3
# Batas waktu tiap panggilan Drive (detik) dan batas menunggu login di browser.
# DRIVE_HTTP_TIMEOUT=20
# DRIVE_LOGIN_TIMEOUT=240

# --- Pengembangan ---
# 1 = tombol Mulai Sesi tetap aktif walau belum login Drive sama sekali (wifi putus
# tidak pernah menghalangi, ini hanya untuk keadaan belum login). Jangan dipakai di acara.
MCF_IZINKAN_TANPA_DRIVE=0
# 1 = Google Drive digantikan tiruan dalam memori — hanya untuk uji otomatis.
# MCF_DRIVE_PALSU=0

# --- Mode photobooth ---
# mcfbooth = photobooth biasa (bawaan). petblessing = mode Pet Blessing
# (sertifikat otomatis, tema Pet Blessing, lihat README).
PHOTOBOOTH_MODE=mcfbooth
# PETBLESSING_API_URL=https://petblessing-api.187.53.129.205.sslip.io
# PETBLESSING_BOOTH_TOKEN=
# DRIVE_FOLDER_SERTIFIKAT=3. Sertifikat
